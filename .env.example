# ---- Backend (FastAPI) ----
APP_ENV=development                 # development | test | production
DATABASE_URL=sqlite:///./data/app.db  # production: postgresql://user:pass@host:5432/db
DATA_DIR=./data                     # uploaded PDFs and FAISS indexes
MIGRATE_ON_STARTUP=true
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED when APP_ENV=production
JWT_EXPIRE_MINUTES=720
FRONTEND_ORIGIN=http://localhost:5173          # comma-separated list allowed

# LLM is optional: with LLM_PROVIDER=none the system runs fully offline (rule-based extractor).
LLM_PROVIDER=none                   # anthropic | openai | none
LLM_API_KEY=
LLM_MODEL=                          # default: claude-opus-5-5 (anthropic) / gpt-4o-mini (openai)

EMBEDDINGS_ENABLED=true             # false -> deterministic keyword retriever (tests, low-memory hosts)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_MB=20
STALE_DAYS=90
LOG_LEVEL=INFO

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:8000
